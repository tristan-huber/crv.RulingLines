    {
      "atomType": "Code",
      "x": 0.38671874999999994,
      "y": 0.5041666666666667,
      "uniqueID": "id-27",
      "ioValues": [
        {
          "name": "surface",
          "ioValue": "__GEOMETRY_INPUT__"
        },
